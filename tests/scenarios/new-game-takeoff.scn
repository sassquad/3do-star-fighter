# The original smoke path: skip the video, PLAY GAME, pick the first mission, read the briefing, fly.
description: main menu -> mission select -> briefing -> first mission, thrust and fly
suite: quick
frames: 2400
performance: yes
expect: in_order(seq('menu'), [0, 5, -1])
expect: first('status', 1, 700) is not None and first('status', 1, 700) < 900
expect: at(1300)['y'] != at(1000)['y'] and at(1300)['speed'] == 256
expect: max(col('speed', 1300, 1520)) > 1500 and at(2400)['speed'] == 256
expect: max(col('thrust', 1300, 1500)) == 1024
expect: max(col('smokes', 1300, 1500)) > 0
expect: last['lives'] == 3 and last['shields'] == 64
expect: last['status'] == 1
script:
300 304 DOWN
330 336 A
480 486 A
600 606 A
760 766 A
900 906 A
1100 1106 A
1300 1500 A
