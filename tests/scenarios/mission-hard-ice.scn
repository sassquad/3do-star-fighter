# Load a save that points the hard pyramid at mission H/11 (Ice planet) - hard level pyramid,
# start it from mission select, then thrust, fire lasers, switch weapon, fire, change camera.
description: Ice planet: Missions/H/MISS_11 from a save fixture
suite: full
frames: 1800
performance: yes
fixture: H 11
expect: ever('menu', 9) and ever('menu', 5)
expect: at(1100)['level'] == 3
expect: first('status', 1, 1000) is not None
expect: max(col('lasers', 1300, 1420)) > 0
expect: ever('weapon', 1, 1430)
expect: ever('camera', 2, 1550)
